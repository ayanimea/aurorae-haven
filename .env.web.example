# Online web mode
VITE_BASE_URL=/aurorae-haven/
VITE_COMPILE_MODE=web-online
VITE_AUTH_REQUIRED=true

# Sign-in providers for web sign-in/sign-up
VITE_AUTH_EMAIL_ENABLED=true
VITE_OAUTH_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_OAUTH_FACEBOOK_APP_ID=your-facebook-app-id
VITE_OAUTH_GITHUB_CLIENT_ID=your-github-client-id

# Backend integration requirements (managed outside this repository)
VITE_API_BASE_URL=https://api.example.com

# Backend-owned secret (do NOT set in frontend .env files):
# Managed by backend server only.

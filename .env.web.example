# Online web mode
VITE_BASE_URL=/aurorae-haven/
AURORAE_COMPILE_MODE=web-online
VITE_AUTH_REQUIRED=true

# OAuth providers for web sign-in
VITE_OAUTH_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_OAUTH_FACEBOOK_APP_ID=your-facebook-app-id
VITE_OAUTH_GITHUB_CLIENT_ID=your-github-client-id

# Backend + PostgreSQL
DATABASE_URL=postgresql://aurorae:aurorae@pgbouncer:6432/aurorae_haven
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aurorae_haven
POSTGRES_USER=aurorae
POSTGRES_PASSWORD=generate-a-strong-password
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=20
SESSION_SECRET=generate-a-strong-random-secret
